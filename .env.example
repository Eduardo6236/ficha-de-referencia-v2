# Copia este archivo como variables de entorno en Vercel (Project Settings > Environment Variables).
# Nunca commitees un .env con las claves reales.

# Nano Banana / Gemini (generación de imagen)
GEMINI_API_KEY=

# Fal.ai (imagen y video, incluye Kling)
FAL_KEY=

# OpenAI (GPT Image 2.5, generación/edición de imagen)
OPENAI_API_KEY=

# MeiGen (generación de imagen)
MEIGEN_API_TOKEN=

# Modelos opcionales; deja estos valores sin definir para usar los recomendados por la aplicación.
# NANO_BANANA_MODEL=gemini-3.1-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=high
# MEIGEN_IMAGE_MODEL=seedream-5.0-pro

# Opcional: modelo de Gemini para traducir el texto libre de la ficha al inglés (usa GEMINI_API_KEY)
TRANSLATE_MODEL=gemini-flash-latest
